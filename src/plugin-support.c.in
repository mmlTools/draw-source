#include <plugin-support.h>

// The plugin-support compilation unit may not have OBS headers on its include path.
// Declare the minimal OBS logging API we need here, rather than including OBS headers.
// (The plugin itself includes <obs-module.h>/<obs.h> normally.)
extern void blog(int log_level, const char *format, ...);

const char *PLUGIN_NAME = "@CMAKE_PROJECT_NAME@";
const char *PLUGIN_VERSION = "@CMAKE_PROJECT_VERSION@";

void obs_log(int log_level, const char *format, ...)
{
	// Format the user message first (with va_list) then emit it via blog().
	char msg[2048];
	msg[0] = '\0';

	va_list args;
	va_start(args, format);
	vsnprintf(msg, sizeof(msg), format, args);
	va_end(args);

	blog(log_level, "[%s] %s", PLUGIN_NAME, msg);
}
